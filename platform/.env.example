# Supabase (Project Settings > API). Without the two public keys the app runs on demo data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only: lets /api/accounts create trainee logins. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# server only: AI for new-food calories (/api/macros) and trainee meal photos (/api/meal).
# Gemini is used when set (Google AI Studio key); ANTHROPIC_API_KEY is an optional fallback.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Two sites from one codebase (lib/site.ts): "client" on the trainee project (app.couchjunior.com),
# "coach" on the coach project (admin.couchjunior.com). Leave empty to serve both, as in demo mode.
NEXT_PUBLIC_SITE_MODE=
# Only if the addresses differ from app.couchjunior.com / admin.couchjunior.com.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_COACH_URL=
